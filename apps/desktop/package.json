{
  "name": "@selecta/desktop",
  "productName": "Selecta",
  "version": "0.1.0",
  "private": true,
  "description": "Selecta desktop app: build playlists from your library with Claude.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.renderer.json && tsc && node build.mjs",
    "e2e": "playwright test",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@selecta/core": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.5.1",
    "selecta": "0.1.0"
  },
  "build": {
    "appId": "io.github.jonas-ross.selecta",
    "copyright": "Copyright © 2026 Jonas Ross",
    "mac": {
      "category": "public.app-category.music",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Selecta reads your library and plays your drafts in Music."
      }
    }
  }
}
