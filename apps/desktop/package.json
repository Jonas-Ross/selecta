{
  "name": "@selecta/desktop",
  "productName": "Selecta",
  "version": "0.1.0",
  "private": true,
  "description": "Selecta desktop app: build playlists from your library with Claude.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.renderer.json && tsc && node build.mjs",
    "e2e": "playwright test",
    "start": "node scripts/start.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@selecta/core": "0.1.0",
    "better-sqlite3": "^13.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "^1.64.1",
    "@types/mdast": "4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "selecta": "0.1.0"
  },
  "build": {
    "appId": "io.github.jonas-ross.selecta",
    "copyright": "Copyright \u00a9 2026 Jonas Ross",
    "directories": {
      "app": ".package/app",
      "output": ".package/out"
    },
    "extraResources": [
      {
        "from": ".package/core",
        "to": "core"
      }
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.music",
      "icon": ".package/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Selecta reads your library and plays your drafts in Music."
      }
    },
    "dmg": {
      "artifactName": "Selecta-${version}-${arch}.${ext}"
    }
  }
}
