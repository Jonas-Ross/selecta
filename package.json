{
  "name": "selecta",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server exposing the Apple Music library to AI agents through MCP.",
  "type": "module",
  "bin": {
    "selecta": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build-ui.mjs",
    "test": "npm run build && vitest run --tags-filter='!integration'",
    "test:integration": "vitest run --tags-filter=integration",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify:echo": "npm run build && node scripts/verify-echo.mjs",
    "dev": "node dist/index.js",
    "lint": "oxlint",
    "format": "oxlint --fix && oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm test && npm run lint && npm run format:check",
    "preview:draft": "npm run build && node scripts/preview-draft.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.1",
    "esbuild": "0.28.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
