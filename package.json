{
  "name": "selecta-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Selecta: the MCP server, the core it runs on, and the apps built on that core.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "apps/*"
  ],
  "bin": {
    "selecta": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @selecta/core && npm run build -w selecta && node scripts/link-entry.mjs && npm run build -w @selecta/desktop",
    "test": "npm run build && vitest run --tags-filter='!integration'",
    "test:integration": "vitest run --tags-filter=integration",
    "smoke": "npm run build && node packages/mcp/scripts/smoke.mjs",
    "dev": "node dist/index.js",
    "lint": "oxlint --type-aware",
    "format": "oxlint --fix && oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm test && npm run lint && npm run format:check",
    "preview": "npm run build && node packages/mcp/scripts/preview.mjs",
    "desktop": "npm run build && npm start -w @selecta/desktop",
    "latest": "apps/desktop/scripts/latest.sh",
    "package": "npm run build && npm run package -w @selecta/desktop --",
    "e2e": "npm run build && npm run e2e -w @selecta/desktop"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-markdown": "2.1.3",
    "mdast-util-find-and-replace": "3.0.2"
  }
}
